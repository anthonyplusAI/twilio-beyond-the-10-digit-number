# Copy to .env, fill in your own Twilio demo account details, then restart the app.
# This app only sends to the fixed phone number below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEMO_TO_NUMBER=

# RCS: a Messaging Service containing your test RCS sender, plus a rich
# Content Template (HX...) prepared for the fictional $9,800.00 vehicle-deposit alert.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_RCS_CONTENT_SID=

# Optional setup helper: upload public/rcs-alert-card.png to a public HTTPS host,
# paste that image URL here, then run npm run create:rcs-template to get an HX SID.
TWILIO_RCS_MEDIA_URL=

# Voice: your number registered for US Enhanced Branded Calling (display name Twilio).
TWILIO_VOICE_FROM=

# Live AI call: ConversationRelay needs a public WSS endpoint. For local
# end-to-end rehearsal, tunnel the app's PORT (for example, ngrok http 3000),
# set PUBLIC_BASE_URL to that tunnel's HTTPS origin, and leave this URL blank.
# Azure also derives the WSS URL from PUBLIC_BASE_URL when this is blank.
# Twilio handles ElevenLabs speech; this app does not need an ElevenLabs API key.
TWILIO_CONVERSATION_RELAY_URL=
# Optional: Twilio voice ID, optionally followed by a documented model and tuning suffix.
TWILIO_ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Presenter controls require a private password entered on /presenter.
# Keep the value only in your local .env and the deployment secret store.
PRESENTER_PASSWORD=

# Local presenter server. It binds to loopback during rehearsal.
PORT=3000

# Azure Container Apps: PORT=8080 and the exact public HTTPS
# origin without a trailing slash, e.g. https://demo.example.azurecontainerapps.io.
# When PUBLIC_BASE_URL is set, the server binds to all container interfaces.
# PUBLIC_BASE_URL derives wss://<same-host>/voice-relay when the relay URL above
# is blank.
PUBLIC_BASE_URL=
